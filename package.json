{
  "name": "authserver",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "schema:generate": "npx --yes auth@1.6.25 generate --config auth.config.ts --output migrations/0001_oidc.sql --yes",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply AUTH_DB --remote"
  },
  "dependencies": {
    "@better-auth/core": "1.6.25",
    "@better-auth/oauth-provider": "1.6.25",
    "@better-auth/utils": "0.4.2",
    "@better-fetch/fetch": "1.3.1",
    "better-auth": "1.6.25",
    "better-call": "1.3.7",
    "hono": "^4.12.31",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260724.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.114.0"
  }
}
